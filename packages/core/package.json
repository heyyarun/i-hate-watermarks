{
  "name": "@i-hate-watermarks/core",
  "version": "0.1.0",
  "description": "Detect and remove invisible Unicode watermarks and carriers from text. Browser and Node, no dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:names": "uv run --no-project --python 3.13 scripts/gen-names.py",
    "gen:fixtures": "uv run --no-project --python 3.13 scripts/gen-fixtures.py"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
